  "paths": {
    "/api/products": {
      "get": {
        "summary": "List products",
        "description": "Returns every matching product, unpaginated, with the number matched, the unfiltered catalog total, and the category options for the current search. Categories with no matching products are omitted.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Free-text search across product name and aliases, matched case-insensitively as whole tokens that must all be present. Maximum 80 characters.",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug. Combined with q using AND semantics. An unknown slug is rejected.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order for the matched set. Equal prices break on product name ascending.",
            "schema": {
              "type": "string",
              "enum": [
                "price-asc",
                "price-desc"
              ],
              "default": "price-asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching products with match and catalog counters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
