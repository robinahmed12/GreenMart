generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Category {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique @db.VarChar(64)
  name      String    @db.VarChar(120)
  sortOrder Int       @map("sort_order")
  products  Product[]

  @@map("categories")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(120)
  name         String   @db.VarChar(160)
  aliases      String[] @default([])
  description  String   @db.Text
  price        Decimal  @db.Decimal(12, 2)
  sellingLabel String   @map("selling_label") @db.VarChar(60)
  sellingKind  String   @map("selling_kind") @db.VarChar(16)
  stockStatus  String   @map("stock_status") @db.VarChar(16)
  imageUrl     String?  @map("image_url") @db.VarChar(512)
  images       String[] @default([])
  origin       String?  @db.VarChar(160)
  storage      String?  @db.Text
  preparation  String?  @db.Text
  nutrition    String?  @db.Text
  allergens    String[] @default([])
  categoryId   String   @map("category_id") @db.Uuid
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([categoryId])
  @@index([price])
  @@map("products")
}