                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "aliases": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1
                        },
                        "price": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMinimum": true
                        },
                        "sellingUnit": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "minLength": 1
                            },
                            "kind": {
                              "type": "string",
                              "enum": [
                                "weight",
                                "count",
                                "bunch",
                                "pack"
                              ]
                            }
                          },
                          "required": [
                            "label",
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        "stockStatus": {
                          "type": "string",
                          "enum": [
                            "in_stock",
                            "low_stock",
                            "out_of_stock"
                          ]
                        },
                        "category": {
                          "type": "object",
                          "properties": {
                            "slug": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "sortOrder": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "slug",
                            "name",
                            "sortOrder"
                          ],
                          "additionalProperties": false
                        },
                        "imageUrl": {
                          "type": "string"
                        },
                        "images": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
