  "info": {
    "title": "Product Catalog API",
    "version": "1.0.0",
    "description": "Read-only catalog service. Responses use a data envelope. Listing responses add a meta block carrying both counters, so an empty catalog (catalogTotal 0) can be told apart from a filter that matched nothing (catalogTotal greater than 0, matched 0)."
  },
